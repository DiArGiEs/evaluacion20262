@model evaluacion20262.Models.SolicitudServicio

@{
    ViewData["Title"] = "Registrar Solicitud";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="text-primary mb-3">Registrar Nueva Solicitud de Servicio</h2>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["MensajeExito"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <form asp-action="Crear" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Cliente" class="form-label">Nombre del Cliente</label>
                    <input asp-for="Cliente" class="form-control" placeholder="Ej. Juan Pérez" />
                    <span asp-validation-for="Cliente" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Telefono" class="form-label">Teléfono</label>
                    <input asp-for="Telefono" class="form-control" placeholder="Ej. 987654321" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Distrito" class="form-label">Distrito</label>
                    <input asp-for="Distrito" class="form-control" placeholder="Ej. Los Olivos" />
                    <span asp-validation-for="Distrito" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="TipoServicio" class="form-label">Tipo de Servicio</label>
                    <select asp-for="TipoServicio" class="form-select">
                        <option value="">-- Seleccione un tipo --</option>
                        <option value="Instalación">Instalación</option>
                        <option value="Mantenimiento">Mantenimiento</option>
                        <option value="Revisión">Revisión</option>
                        <option value="Fuga">Fuga</option>
                    </select>
                    <span asp-validation-for="TipoServicio" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Descripcion" class="form-label">Descripción</label>
                    <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Detalles de la solicitud (opcional)"></textarea>
                    <span asp-validation-for="Descripcion" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary">Guardar Solicitud</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}